# =====================================================
# EcoPlate AI — Backend Environment Variables
# =====================================================
# Copy this file to .env and fill in your values.
# Without an API key the app runs in Demo Mode.
# =====================================================

PORT=3001

# --- Groq (FREE — recommended for getting started) ---
# Sign up free at https://console.groq.com
# Click API Keys → Create API Key → paste below
GROQ_API_KEY=

# --- OpenAI (paid alternative) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the AI model
# Groq defaults to:  openai/gpt-oss-20b  (free)
# OpenAI defaults to: gpt-4o-mini
AI_MODEL=

# Set to "true" to force demo mode even when a key is present
DEMO_MODE=false
